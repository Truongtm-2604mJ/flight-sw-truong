digraph vehicle_mode {
  rankdir=LR; fontname="Helvetica"; bgcolor="white";
  label="vehicle_mode v2 - one transition per 2 s cycle, lower priority number wins\nsolid = ground TC, dashed = autonomous fault, dotted = internal (refusal reported)";
  labelloc=b; fontsize=11;
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=13, width=1.6, height=0.7];
  edge [fontname="Helvetica", fontsize=10];
  boot [shape=point, width=0.15, fillcolor=black];
  NOMINAL  [fillcolor="#d8f0d8"];
  DEGRADED [fillcolor="#fff2c6"];
  SAFE     [fillcolor="#f8d4d0", label="SAFE\nentry: payload off, schedule suspended,\nHK minimal, monitors 2 Hz, sun pointing, RX on\nexit: release sun pointing", fontsize=11];
  boot -> NOMINAL [label="cold boot"];
  boot -> SAFE [label="watchdog reset /\ninvalid state"];
  NOMINAL -> SAFE [label="T01 tc_mode_safe  p1"];
  NOMINAL -> SAFE [label="T02 fault_critical [!inh]  p2", style=dashed];
  NOMINAL -> DEGRADED [label="T03 tc_mode_degraded  p3"];
  NOMINAL -> DEGRADED [label="T04 fault_noncritical [!inh]  p4", style=dashed];
  NOMINAL -> NOMINAL [label="T05/T06 fault [inh]  p5/p6", style=dotted];
  DEGRADED -> SAFE [label="T07 tc_mode_safe  p1"];
  DEGRADED -> SAFE [label="T08 fault_critical [!inh]  p2", style=dashed];
  DEGRADED -> NOMINAL [label="T09 tc_mode_nominal  p3"];
  DEGRADED -> DEGRADED [label="T10 fault_critical [inh]  p4", style=dotted];
  SAFE -> DEGRADED [label="T11 tc_mode_degraded  p1"];
  SAFE -> NOMINAL [label="T12 tc_mode_nominal  p2"];
}
